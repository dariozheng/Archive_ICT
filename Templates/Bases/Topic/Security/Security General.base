properties:
  file.name:
    displayName: Page
  note.created:
    displayName: Created
  note.modified:
    displayName: Modified
views:
  - type: table
    name: Table
    filters:
      and:
        - note["topic@security"].contains(link("Security General"))
    order:
      - file.name
    sort:
      - property: created
        direction: ASC
      - property: file.name
        direction: DESC
    columnSize:
      note.created: 116
