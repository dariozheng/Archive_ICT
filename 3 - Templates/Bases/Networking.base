properties:
  file.name:
    displayName: Page
  note.topic@networking:
    displayName: Topic
  note.status:
    displayName: Status
views:
  - type: table
    name: Table
    filters:
      and:
        - categories.contains(link("Networking"))
        - '!file.name.contains("Template")'
    order:
      - file.name
      - topic@networking
      - status
    sort:
      - property: topic@networking
        direction: ASC
      - property: file.name
        direction: ASC
    columnSize:
      file.name: 232
