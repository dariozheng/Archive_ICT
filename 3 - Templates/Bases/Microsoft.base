properties:
  file.name:
    displayName: Page
  note.topic@microsoft:
    displayName: Topic
  note.status:
    displayName: Status
views:
  - type: table
    name: Table
    filters:
      and:
        - categories.contains(link("Microsoft"))
        - '!file.name.contains("Template")'
    order:
      - file.name
      - topic@microsoft
      - status
    sort:
      - property: topic@microsoft
        direction: ASC
      - property: file.name
        direction: ASC
