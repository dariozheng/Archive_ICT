properties:
  file.name:
    displayName: Page
  note.status:
    displayName: Status
  file.mtime:
    displayName: Modified
views:
  - type: table
    name: Table
    filters:
      and:
        - note["topic@security"].contains(link("Security General"))
    order:
      - file.name
      - status
      - file.mtime
    sort:
      - property: file.name
        direction: ASC
    columnSize:
      file.name: 301
