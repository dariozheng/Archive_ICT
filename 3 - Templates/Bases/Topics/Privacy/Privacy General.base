properties:
  file.name:
    displayName: Page
  note.status:
    displayName: Status
views:
  - type: table
    name: Table
    filters:
      and:
        - categories.contains(link("Privacy"))
        - note["topic@privacy"].contains(link("Privacy General"))
    order:
      - file.name
      - status
    sort:
      - property: file.name
        direction: ASC
