properties:
  file.name:
    displayName: Page
  note.status:
    displayName: Status
views:
  - type: table
    name: Table
    filters:
      and:
        - note["topic@networking"].contains(link("Virtualization and Overlays"))
    order:
      - file.name
      - status
    sort:
      - property: file.name
        direction: ASC
