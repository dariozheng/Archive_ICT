properties:
  file.name:
    displayName: Page
  note.topic@linux:
    displayName: Topic
  note.status:
    displayName: Status
views:
  - type: table
    name: Table
    filters:
      and:
        - categories.contains(link("Linux"))
        - '!file.name.contains("Template")'
    order:
      - file.name
      - topic@linux
      - status
    sort:
      - property: topic@linux
        direction: ASC
      - property: file.name
        direction: ASC
