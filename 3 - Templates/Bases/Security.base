properties:
  file.name:
    displayName: Page
  note.topic@security:
    displayName: Topic
  note.status:
    displayName: Status
views:
  - type: table
    name: Table
    filters:
      and:
        - categories.contains(link("Security"))
        - '!file.name.contains("Template")'
    order:
      - file.name
      - topic@security
      - status
    sort:
      - property: topic@security
        direction: ASC
      - property: file.name
        direction: ASC
    columnSize:
      file.name: 503
      note.topic@security: 177
