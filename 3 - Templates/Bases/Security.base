properties:
  file.name:
    displayName: Page
  note.section:
    displayName: Section
  note.topic:
    displayName: Topic
  note.topic@security:
    displayName: Topic
views:
  - type: table
    name: Table
    filters:
      and:
        - categories.contains(link("Security"))
        - '!file.name.contains("Template")'
    order:
      - file.name
      - topic@security
    sort:
      - property: icon
        direction: DESC
      - property: section
        direction: ASC
    columnSize:
      file.name: 503
      note.topic@security: 177
